# Application
PYTHONPATH=.
LOG_LEVEL=INFO

# Model paths (relative to repo root)
MODELS_DIR=models
CACHE_DIR=data/cache

# Gradio behavior — set USE_REMOTE_API=true to delegate to Railway API
USE_REMOTE_API=false
API_URL=http://localhost:8000

# Optional: Alpha Vantage fallback for yfinance outages (free tier, 25 req/day)
# Get a key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=
