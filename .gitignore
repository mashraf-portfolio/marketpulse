# Project-specific
hf_space/
# data/cache/ — joblib OHLCV cache for the 23-ticker whitelist.
# The pickled cache (data/cache/joblib/**) is INTENTIONALLY COMMITTED so
# deployed services (Railway API, HF Space) work offline w/o yfinance.
# Only ad-hoc parquet/csv exports are excluded:
data/cache/*.parquet
data/cache/*.csv
!data/cache/.keep_whitelist
models/checkpoints/
!models/checkpoints/.gitkeep
!models/feature_names.json
!models/metadata/
*.log

# PyTorch Lightning / pytorch-forecasting training artifacts
# — checkpoints/ is the default Lightning ModelCheckpoint dir
# — lightning_logs/ is the default CSVLogger dir
# Both are written under cwd when TFT models train (tests, sanity
# fits, future Phase 5 walk-forward runs). Per-run state, not source.
checkpoints/
lightning_logs/

# Claude Code local workspace
.claude/

# Conversation handoff working notes (local only, never tracked)
docs/handoff_*.md
